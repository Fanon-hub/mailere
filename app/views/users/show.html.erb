<h1>User Details</h1>
<p>Name: <%= @user.name %></p>
<p>Email: <%= @user.email %></p>
<p>Profile Image:</p>
<% if @user.profile_image.attached? %>
  <%= image_tag url_for(@user.profile_image), style: "width: 200px; height: 200px; object-fit: cover;" %>  
<% end %>

<% unless @user.profile_image.attached? %>
  <p>No profile image uploaded.</p>
<% end %> 